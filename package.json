{
  "name": "fantasybb-site",
  "version": "1.0.0",
  "private": true,
  "description": "Fantasy NBA League Web App - Premium analytics and narrative experience",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "database:migrate": "node scripts/run-tsx.cjs scripts/migrate-database.ts",
    "database:import:profiles": "node scripts/run-tsx.cjs scripts/import-profiles.ts",
    "database:import:stats": "node scripts/run-tsx.cjs scripts/import-stats-room.ts",
    "database:import": "npm run database:import:profiles && npm run database:import:stats",
    "database:verify:profiles": "node scripts/run-tsx.cjs scripts/verify-profile-import.ts",
    "database:verify:stats": "node scripts/run-tsx.cjs scripts/verify-stats-room-import.ts",
    "database:verify": "npm run database:verify:profiles && npm run database:verify:stats",
    "database:status": "node scripts/run-tsx.cjs scripts/database-status.ts",
    "database:setup": "npm run database:migrate && npm run database:import && npm run database:verify"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.0",
    "framer-motion": "^11.0.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.344.0",
    "next": "^14.2.0",
    "postgres": "^3.4.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.12.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0"
  }
}
